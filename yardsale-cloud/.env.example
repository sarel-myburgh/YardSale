NODE_ENV=development
YARDSALE_CLOUD_PORT=3010
YARDSALE_CLOUD_BASE_DOMAIN=yardsale.local
# Public HTTPS origin used for payment callbacks behind a reverse proxy.
YARDSALE_CLOUD_PUBLIC_ORIGIN=
YARDSALE_CLOUD_DATA_DIR=.yardsale-cloud
YARDSALE_CLOUD_BACKUP_DIR=.yardsale-cloud/backups
YARDSALE_CLOUD_BACKUP_INTERVAL_HOURS=24
YARDSALE_CLOUD_RUNTIME=local
YARDSALE_CLOUD_RUNTIME_EXECUTE=false
YARDSALE_CLOUD_REQUIRE_EMAIL_VERIFICATION=false
YARDSALE_CLOUD_COOKIE_SECURE=false
# Only enable when Caddy (or another trusted proxy) is the direct peer.
YARDSALE_CLOUD_TRUST_PROXY=false
YARDSALE_CLOUD_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
YARDSALE_CLOUD_WEBHOOK_SECRET=replace-with-a-long-random-secret
YARDSALE_CLOUD_METRICS_TOKEN=

# Set billing to aba-payway only after merchant credentials and callbacks are validated.
YARDSALE_CLOUD_BILLING_PROVIDER=mock
YARDSALE_CLOUD_ABA_MERCHANT_ID=
YARDSALE_CLOUD_ABA_API_KEY=
# Use https://checkout-sandbox.payway.com.kh for sandbox validation.
YARDSALE_CLOUD_ABA_BASE_URL=https://checkout.payway.com.kh
